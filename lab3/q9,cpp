#include <iostream>
#include <string>
using namespace std;

class Product {
private:
    int id;
    string name;
    float price;
    int quantity;

public:
    void accept() {
        cout << "Enter Product ID: ";
        cin >> id;
        cin.ignore();
        cout << "Enter Product Name: ";
        getline(cin, name);
        cout << "Enter Price: ";
        cin >> price;
        cout << "Enter Quantity: ";
        cin >> quantity;
    }

    void display() const {
        cout << "ID: " << id << " | Name: " << name 
                  << " | Price: $" << price << " | Qty: " << quantity 
                  << " | Subtotal: $" << getTotalCost() << endl;
    }

    float getTotalCost() const {
        return price * quantity;
    }
};

int main() {
    int n;
    cout << "Enter number of items in cart: ";
    cin >> n;

    Product* cart = new Product[n];

    for (int i = 0; i < n; i++) {
        cout << "\nItem " << i + 1 << " details:\n";
        cart[i].accept();
    }

    float grandTotal = 0;
    cout << "\n=== Shopping Cart Summary ===" << endl;
    for (int i = 0; i < n; i++) {
        cart[i].display();
        grandTotal += cart[i].getTotalCost();
    }

    cout << "\nGrand Total Bill: $" << grandTotal << endl;

    delete[] cart;
    cart = nullptr;
    return 0;
}